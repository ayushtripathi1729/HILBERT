  n6 [label="#6 tau(p) = 2 assuming isPrime(p) = 1\nCONJECTURE"];
  n7 [label="#7 sigma(p) = (p + 1) assuming isPrime(p) = 1\nCONJECTURE"];
  n8 [label="#8 nCr(n,k) = nCr(n,(n + -(k))) assuming n >= 0 and k >= 0 and k <= n\nCONDITIONAL_THEOREM"];
  n9 [label="#9 nCr(n,(n + -(k))) = nCr(n,(n + -((n + -(k))))) assuming n >= 0 and (n + -(k)) >= 0 and (n + -(k)) <= n\nLEMMA_FOUND"];

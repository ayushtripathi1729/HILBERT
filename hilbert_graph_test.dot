digraph HILBERT_RESEARCH {
  rankdir=LR;
  n1 [label="#1 gcd(a,b) = gcd(b,mod(a,b)) assuming b != 0\nVACUOUS"];
  n2 [label="#2 phi((a * b)) = (phi(a) * phi(b)) assuming gcd(a,b) = 1\nCONJECTURE"];
  n3 [label="#3 tau((a * b)) = (tau(a) * tau(b)) assuming gcd(a,b) = 1\nVACUOUS"];
  n4 [label="#4 sigma((a * b)) = (sigma(a) * sigma(b)) assuming gcd(a,b) = 1\nVACUOUS"];

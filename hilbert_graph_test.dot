  n41 [label="#41 ((x + b) * (z + c)) = (((((1 * x) * z) + ((1 * x) * c)) + ((1 * b) * z)) + ((1 * b) * c))\nTHEOREM"];
  n42 [label="#42 ((a + w) * (z + b)) = (((((1 * a) * z) + ((1 * a) * b)) + ((1 * w) * z)) + ((1 * w) * b))\nTHEOREM"];

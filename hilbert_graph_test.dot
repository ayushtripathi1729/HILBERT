digraph HILBERT_RESEARCH {
  rankdir=LR;
  n1 [label="#1 gcd(a,b) = gcd(b,mod(a,b)) assuming b != 0\nCONJECTURE"];
  n2 [label="#2 phi((a * b)) = (phi(a) * phi(b)) assuming gcd(a,b) = 1\nCONJECTURE"];
  n3 [label="#3 tau((a * b)) = (tau(a) * tau(b)) assuming gcd(a,b) = 1\nCONJECTURE"];
  n4 [label="#4 sigma((a * b)) = (sigma(a) * sigma(b)) assuming gcd(a,b) = 1\nCONJECTURE"];
  n5 [label="#5 phi(p) = (p + -(1)) assuming isPrime(p) = 1\nCONJECTURE"];
  n6 [label="#6 tau(p) = 2 assuming isPrime(p) = 1\nCONJECTURE"];
  n7 [label="#7 sigma(p) = (p + 1) assuming isPrime(p) = 1\nCONJECTURE"];
  n8 [label="#8 nCr(n,k) = nCr(n,(n + -(k))) assuming n >= 0 and k >= 0 and k <= n\nCONDITIONAL_THEOREM"];
  n9 [label="#9 nCr(n,(n + -(k))) = nCr(n,(n + -((n + -(k))))) assuming n >= 0 and (n + -(k)) >= 0 and (n + -(k)) <= n\nLEMMA_FOUND"];
  n10 [label="#10 nCr(n,k) = (nCr((n + -(1)),(k + -(1))) + nCr((n + -(1)),k)) assuming n >= 1 and k >= 1 and k <= n\nCONDITIONAL_THEOREM"];
  n11 [label="#11 nCr((n + -(1)),(k + -(1))) = nCr((n + -(1)),((n + -(1)) + -((k + -(1))))) assuming (n + -(1)) >= 0 and (k + -(1)) >= 0 and (k + -(1)) <= (n + -(1))\nLEMMA_FOUND"];
  n12 [label="#12 nCr((n + -(1)),k) = nCr((n + -(1)),((n + -(1)) + -(k))) assuming (n + -(1)) >= 0 and k >= 0 and k <= (n + -(1))\nLEMMA_FOUND"];
  n13 [label="#13 fib((n + 2)) = (fib((n + 1)) + fib(n)) assuming n >= 0\nCONDITIONAL_THEOREM"];
  n14 [label="#14 factorial((n + 1)) = ((n + 1) * factorial(n)) assuming n >= 0\nCONDITIONAL_THEOREM"];
  n15 [label="#15 derangements(n) = ((n + -(1)) * (derangements((n + -(1))) + derangements((n + -(2))))) assuming n >= 2\nCONDITIONAL_THEOREM"];
  n16 [label="#16 derangements((n + -(1))) = (((n + -(1)) + -(1)) * (derangements(((n + -(1)) + -(1))) + derangements(((n + -(1)) + -(2))))) assuming (n + -(1)) >= 2\nLEMMA_FOUND"];
  n17 [label="#17 derangements((n + -(2))) = (((n + -(2)) + -(1)) * (derangements(((n + -(2)) + -(1))) + derangements(((n + -(2)) + -(2))))) assuming (n + -(2)) >= 2\nLEMMA_FOUND"];
  n18 [label="#18 derangements(((n * t) + -(2))) = ((((n * t) + -(2)) + -(1)) * (derangements((((n * t) + -(2)) + -(1))) + derangements((((n * t) + -(2)) + -(2))))) assuming ((n * t) + -(2)) >= 2\nCONDITIONAL_THEOREM"];
  n19 [label="#19 derangements((((n * t) + -(2)) + -(1))) = (((((n * t) + -(2)) + -(1)) + -(1)) * (derangements(((((n * t) + -(2)) + -(1)) + -(1))) + derangements(((((n * t) + -(2)) + -(1)) + -(2))))) assuming (((n * t) + -(2)) + -(1)) >= 2\nLEMMA_FOUND"];
  n20 [label="#20 derangements((((n * t) + -(2)) + -(2))) = (((((n * t) + -(2)) + -(2)) + -(1)) * (derangements(((((n * t) + -(2)) + -(2)) + -(1))) + derangements(((((n * t) + -(2)) + -(2)) + -(2))))) assuming (((n * t) + -(2)) + -(2)) >= 2\nLEMMA_FOUND"];
  n21 [label="#21 derangements((n + 1)) = (((n + 1) + -(1)) * (derangements(((n + 1) + -(1))) + derangements(((n + 1) + -(2))))) assuming (n + 1) >= 2\nCONDITIONAL_THEOREM"];
  n22 [label="#22 factorial(((n + -(1)) + 1)) = (((n + -(1)) + 1) * factorial((n + -(1)))) assuming (n + -(1)) >= 0\nCONDITIONAL_THEOREM"];
  n23 [label="#23 fib(((n + 1) + 2)) = (fib(((n + 1) + 1)) + fib((n + 1))) assuming (n + 1) >= 0\nCONDITIONAL_THEOREM"];
  n24 [label="#24 sigma(((a + 1) * b)) = (sigma((a + 1)) * sigma(b)) assuming gcd((a + 1),b) = 1\nCONJECTURE"];
  n25 [label="#25 sigma((a * (b + 1))) = (sigma(a) * sigma((b + 1))) assuming gcd(a,(b + 1)) = 1\nCONJECTURE"];
  n26 [label="#26 (sigma(a) * sigma(b)) = sigma((a * b)) assuming gcd(a,b) = 1\nCONJECTURE"];
  n27 [label="#27 tau(((a + 1) * b)) = (tau((a + 1)) * tau(b)) assuming gcd((a + 1),b) = 1\nCONJECTURE"];

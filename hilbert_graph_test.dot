  n12 [label="#12 nCr((n + -(1)),k) = nCr((n + -(1)),((n + -(1)) + -(k))) assuming (n + -(1)) >= 0 and k >= 0 and k <= (n + -(1))\nVACUOUS"];
  n13 [label="#13 fib((n + 2)) = (fib((n + 1)) + fib(n)) assuming n >= 0\nCONDITIONAL_THEOREM"];
  n14 [label="#14 factorial((n + 1)) = ((n + 1) * factorial(n)) assuming n >= 0\nCONDITIONAL_THEOREM"];
  n15 [label="#15 derangements(n) = ((n + -(1)) * (derangements((n + -(1))) + derangements((n + -(2))))) assuming n >= 2\nCONDITIONAL_THEOREM"];
  n16 [label="#16 derangements((n + -(1))) = (((n + -(1)) + -(1)) * (derangements(((n + -(1)) + -(1))) + derangements(((n + -(1)) + -(2))))) assuming (n + -(1)) >= 2\nLEMMA_FOUND"];
  n17 [label="#17 derangements((n + -(2))) = (((n + -(2)) + -(1)) * (derangements(((n + -(2)) + -(1))) + derangements(((n + -(2)) + -(2))))) assuming (n + -(2)) >= 2\nLEMMA_FOUND"];
  n18 [label="#18 derangements(((n * t) + -(2))) = ((((n * t) + -(2)) + -(1)) * (derangements((((n * t) + -(2)) + -(1))) + derangements((((n * t) + -(2)) + -(2))))) assuming ((n * t) + -(2)) >= 2\nVACUOUS"];
  n19 [label="#19 derangements((((n * t) + -(2)) + -(1))) = (((((n * t) + -(2)) + -(1)) + -(1)) * (derangements(((((n * t) + -(2)) + -(1)) + -(1))) + derangements(((((n * t) + -(2)) + -(1)) + -(2))))) assuming (((n * t) + -(2)) + -(1)) >= 2\nVACUOUS"];
  n20 [label="#20 derangements((((n * t) + -(2)) + -(2))) = (((((n * t) + -(2)) + -(2)) + -(1)) * (derangements(((((n * t) + -(2)) + -(2)) + -(1))) + derangements(((((n * t) + -(2)) + -(2)) + -(2))))) assuming (((n * t) + -(2)) + -(2)) >= 2\nVACUOUS"];
  n21 [label="#21 derangements((n + 1)) = (((n + 1) + -(1)) * (derangements(((n + 1) + -(1))) + derangements(((n + 1) + -(2))))) assuming (n + 1) >= 2\nCONDITIONAL_THEOREM"];
  n22 [label="#22 factorial(((n + -(1)) + 1)) = (((n + -(1)) + 1) * factorial((n + -(1)))) assuming (n + -(1)) >= 0\nCONDITIONAL_THEOREM"];
  n23 [label="#23 fib(((n + 1) + 2)) = (fib(((n + 1) + 1)) + fib((n + 1))) assuming (n + 1) >= 0\nCONDITIONAL_THEOREM"];
  n24 [label="#24 phi(((a + 1) * b)) = (phi((a + 1)) * phi(b)) assuming gcd((a + 1),b) = 1\nCONJECTURE"];
  n25 [label="#25 phi((a * (b + 1))) = (phi(a) * phi((b + 1))) assuming gcd(a,(b + 1)) = 1\nCONJECTURE"];

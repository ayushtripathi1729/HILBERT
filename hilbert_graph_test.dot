  n52 [label="#52 nCr(((y * b) + (a + a)),(((y * b) + (a + a)) + -(-(m)))) = nCr(((y * b) + (a + a)),(((y * b) + (a + a)) + -((((y * b) + (a + a)) + -(-(m)))))) assuming ((y * b) + (a + a)) >= 0 and (((y * b) + (a + a)) + -(-(m))) >= 0 and (((y * b) + (a + a)) + -(-(m))) <= ((y * b) + (a + a))\nLEMMA_FOUND"];
